# Only explicitly approved project surfaces belong in the public repository.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/LICENSE
!/README.md
!/package.json
!/package-lock.json
!/.vscode/
!/.github/
!/docs/
!/tools/
!/tests/
!/src/
!/mods/

# Keep proprietary inputs, generated output, and secrets out of allowed trees too.
**/node_modules/
**/local-data/
**/private/
**/output/
**/dist/
**/coverage/
**/.env
**/.env.*
**/*.exe
**/*.dll
**/*.msi
**/*.bin
**/*.iso
**/*.img
**/*.cab
**/*.zip
**/*.7z
**/*.rar
**/*.log
**/*.pem
**/*.key
**/*~
.vscode/*
!.vscode/tasks.json
.github/*
!.github/workflows/
